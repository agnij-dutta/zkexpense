// GENERATED by scripts/build.sh. Aggregates 2 proofs of circuits/batch_64 into one report.
use zkexpense_lib::{aggregate, Inner, INNER_VK_LEN, Policy, Report};

global K: u32 = 2;
global BATCH: u32 = 64;
// Poseidon2 vk hash of circuits/batch_64 (bb write_vk -t noir-recursive-no-zk).
global PINNED_VK_HASH: Field = 0x2ff8b247e26a9adef1d32b1ccb1d510d26cc436ead92a56eba452cebb628f5b0;

fn main(
    policy: pub Policy,
    inner_vk: [Field; INNER_VK_LEN],
    inner_vk_hash: Field,
    inners: [Inner; K],
    boundaries: [u64; K],
    total_blind: Field,
) -> pub Report {
    aggregate(
        policy,
        BATCH,
        inner_vk,
        inner_vk_hash,
        PINNED_VK_HASH,
        inners,
        boundaries,
        total_blind,
    )
}
